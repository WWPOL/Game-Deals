DEBUG=true

SECRET_KEY=django-insecure-default-key-change-this-in-production

# Google Custom Search API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_api_key_here

# Create a Custom Search Engine at: https://programmablesearchengine.google.com/
# Make sure to enable "Image search" and set "Sites to search" to "*" for entire web
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Google OAuth Configuration (for admin authentication)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID with these authorized redirect URIs:
#   - http://localhost:8000/accounts/google/login/callback/ (development)
#   - https://yourdomain.com/accounts/google/login/callback/ (production)
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_OAUTH_SECRET=your_oauth_secret_here

# Note: Discord webhooks are now configured via the admin panel (NotificationChannel model)
# No environment variables needed for Discord integration

# S3-Compatible Storage Configuration (optional - for production)
# Works with AWS S3, Digital Ocean Spaces, MinIO, Wasabi, etc.
USE_S3_STORAGE=false

# Required when USE_S3_STORAGE=true
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=your-bucket-name
S3_REGION=us-east-1
S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com

# Optional: CDN domain for faster access (recommended for production)
# S3_CUSTOM_DOMAIN=cdn.yourdomain.com

# Temporary directory for image downloads (used by color extraction)
# In Kubernetes, map this to an emptyDir volume
TEMP_DOWNLOAD_DIR=/tmp/game-deals
